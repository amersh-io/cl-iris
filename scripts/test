#!/bin/sh
# Run the test suite with the toolchain installed by scripts/bootstrap.
# Exits non-zero when a test fails. CL_IRIS_TEST_ONLY=<text> runs only the
# checks whose names contain <text>; CL_IRIS_TEST_VISIBLE=1 shows the test
# windows, which are otherwise kept transparent.
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
export PATH="$ROOT/.local/bin:$PATH"
cd "$ROOT"

qlot exec sbcl --non-interactive \
  --eval '(asdf:load-asd (truename "cl-iris.asd"))' \
  --eval '(asdf:test-system "cl-iris")' \
  --eval '(format t "~&ALL-TESTS-PASSED~%")'
